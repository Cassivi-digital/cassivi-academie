[
 {
  "t0": 0.0,
  "t1": 1.897,
  "text": "Et si une compétence digitale…"
 },
 {
  "t0": 2.293,
  "t1": 3.513,
  "text": "devenait ton vrai métier ?"
 },
 {
  "t0": 4.328,
  "t1": 7.649,
  "text": "Chaque jour, les entreprises investissent dans la publicité en ligne pour trouver de nouveaux clients."
 },
 {
  "t0": 7.926,
  "t1": 9.213,
  "text": "Mais investir ne suffit pas."
 },
 {
  "t0": 9.812,
  "t1": 11.182,
  "text": "Sans pilotage…"
 },
 {
  "t0": 11.635,
  "t1": 12.695,
  "text": "le budget s'envole,"
 },
 {
  "t0": 13.076,
  "t1": 14.133,
  "text": "et les résultats ne suivent pas."
 },
 {
  "t0": 14.467,
  "t1": 15.758,
  "text": "C'est là qu'intervient le Média Buyer."
 },
 {
  "t0": 16.551,
  "t1": 18.43,
  "text": "Il crée et pilote les campagnes Meta et Google Ads,"
 },
 {
  "t0": 18.917,
  "t1": 22.121,
  "text": "installe le tracking,"
 },
 {
  "t0": 22.567,
  "t1": 23.659,
  "text": "analyse les données…"
 },
 {
  "t0": 23.991,
  "t1": 24.956,
  "text": "et transforme chaque budget en résultats mesurables."
 },
 {
  "t0": 25.402,
  "t1": 28.247,
  "text": "Et cette compétence peut devenir ton activité freelance."
 },
 {
  "t0": 28.898,
  "t1": 31.657,
  "text": "Un client à trois cents euros par mois."
 },
 {
  "t0": 32.352,
  "t1": 34.108,
  "text": "Deux clients à cinq cents euros."
 },
 {
  "t0": 34.637,
  "t1": 36.199,
  "text": "Trois clients à sept cents euros…"
 },
 {
  "t0": 36.663,
  "t1": 38.267,
  "text": "soit deux mille cent euros par mois."
 },
 {
  "t0": 38.665,
  "t1": 40.459,
  "text": "Ce sont des exemples,"
 },
 {
  "t0": 41.0,
  "t1": 44.581,
  "text": "pas des promesses : tout dépend de ton niveau,"
 },
 {
  "t0": 44.834,
  "t1": 45.836,
  "text": "de ton expérience,"
 },
 {
  "t0": 46.118,
  "t1": 48.128,
  "text": "et de ta capacité à trouver des clients."
 },
 {
  "t0": 48.804,
  "t1": 50.391,
  "text": "Mais tu peux travailler à distance,"
 },
 {
  "t0": 50.678,
  "t1": 52.028,
  "text": "avec des entreprises d'ici…"
 },
 {
  "t0": 52.366,
  "t1": 52.952,
  "text": "ou d'ailleurs."
 },
 {
  "t0": 53.703,
  "t1": 55.558,
  "text": "Chez Cassivi Digital MG,"
 },
 {
  "t0": 55.919,
  "t1": 58.762,
  "text": "ne te contente pas de découvrir le marketing digital."
 },
 {
  "t0": 59.286,
  "t1": 62.586,
  "text": "Apprends à maîtriser une compétence recherchée par les entreprises."
 },
 {
  "t0": 63.175,
  "t1": 64.42,
  "text": "Une formation pratique,"
 },
 {
  "t0": 64.713,
  "t1": 65.454,
  "text": "progressive,"
 },
 {
  "t0": 65.78,
  "t1": 66.932,
  "text": "sur de vraies campagnes."
 },
 {
  "t0": 67.473,
  "t1": 69.532,
  "text": "Formation Média Buyer Freelance."
 },
 {
  "t0": 69.925,
  "t1": 71.003,
  "text": "Inscriptions ouvertes,"
 },
 {
  "t0": 71.266,
  "t1": 72.23,
  "text": "à Antsakavirou."
 },
 {
  "t0": 72.747,
  "t1": 74.38,
  "text": "Les places sont très limitées."
 },
 {
  "t0": 74.916,
  "t1": 77.224,
  "text": "Réserve ta place maintenant, sur WhatsApp :"
 },
 {
  "t0": 77.555,
  "t1": 79.537,
  "text": "zéro trente-sept, cinquante-neuf,"
 },
 {
  "t0": 79.811,
